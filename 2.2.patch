+func paginateLDAPPrincipals(principals []v3.Principal, page, pageSize int) []v3.Principal {
+	if page <= 0 || pageSize <= 0 {
+		return principals
+	}
+
+	start := (page - 1) * pageSize
+	if start >= len(principals) {
+		return []v3.Principal{}
+	}
+
+	end := start + pageSize
+	if end > len(principals) {
+		end = len(principals)
+	}
+
+	return principals[start:end]
+}
