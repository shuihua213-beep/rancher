+	list, err := s.settings.List(metav1.ListOptions{})
+	if err != nil {
+		return nil, err
+	}
+
+	result := make(map[string]*v3.Setting, len(list.Items))
+	for i := range list.Items {
+		item := &list.Items[i]
+		result[item.Name] = item
+	}
+	return result, nil
